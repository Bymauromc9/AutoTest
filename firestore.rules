rules_version = '2';
// Reglas de Firestore de la web (Firebase → Firestore Database → Reglas → pegar y «Publicar»).
//
//   usuarios/{uid}   nombre, id, puntos, tests, ultimo, creado, fli, fc, ip, gohp, w<semana>, bloqueado, admin,
//                    insignias { <id>: { f: fecha, n: veces, m?: motivo } }, vitrina [ids], reclamada
//                    Lo lee cualquiera (es el ranking y el perfil público); su dueño sólo lo escribe para:
//                    · sumar los puntos de UN test: tests +1, los mismos puntos en el total, en una asignatura y
//                      en la semana actual, y no más de los que da tiempo a ganar desde el último test;
//                    · reclamar UNA insignia automática que ya se ha ganado (lo comprueba con su definición);
//                    · elegir hasta 6 de sus insignias para destacarlas en su vitrina.
//                    Una cuenta bloqueada ya no suma ni reclama. Un administrador puede corregir los puntos,
//                    bloquear y dar, quitar o cambiar insignias. «admin» sólo lo escribe scripts/admin/admin.js.
//   insignias/{id}   definición de cada insignia (nombre, icono, forma, color, rareza; las automáticas, el
//                    campo y el umbral que hay que alcanzar): la lee cualquiera, la escribe un admin.
//   retos/{semana}   ganadores de cada reto semanal ya entregado: lo lee cualquiera, lo crea un admin.
//   progreso/{uid}   { t, json }  el progreso guardado de la cuenta; sólo lo ve y lo escribe su dueño.
//   config/web       aviso para toda la web y fechas de exámenes: lo lee cualquiera, lo escribe un admin.
//   reportes/{id}    errores que mandan los usuarios: los crea cualquiera con cuenta (no bloqueada);
//                    sólo los administradores los leen, los marcan como resueltos o los borran.
//
// Administrador = cuenta con la «custom claim» admin: true (node scripts/admin/admin.js admin <usuario>).
service cloud.firestore {
  match /databases/{database}/documents {

    // Semana actual (lunes a domingo, hora de Madrid en invierno): la misma cuenta que assets/js/cuentas.js.
    function semana() {
      return 'w' + string(int((request.time.toMillis() + 262800000) / 604800000));
    }
    function nuevo() { return request.resource.data; }
    function viejo() { return resource.data; }
    function delta() { return nuevo().puntos - viejo().puntos; }
    function cambio(k) { return nuevo().get(k, 0) - viejo().get(k, 0); }
    function unaAsignatura() {
      return (cambio('fli') == delta() && cambio('fc') == 0 && cambio('ip') == 0 && cambio('gohp') == 0)
          || (cambio('fc') == delta() && cambio('fli') == 0 && cambio('ip') == 0 && cambio('gohp') == 0)
          || (cambio('ip') == delta() && cambio('fli') == 0 && cambio('fc') == 0 && cambio('gohp') == 0)
          || (cambio('gohp') == delta() && cambio('fli') == 0 && cambio('fc') == 0 && cambio('ip') == 0);
    }
    function esSuyo(uid) { return request.auth != null && request.auth.uid == uid; }
    function esAdmin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    // Campo numérico entero y no negativo (si falta, cuenta como 0).
    function natural(k) { return nuevo().get(k, 0) is int && nuevo().get(k, 0) >= 0; }
    // Campo de texto obligatorio de, como mucho, max caracteres.
    function texto(k, max) { return nuevo()[k] is string && nuevo()[k].size() <= max; }
    // Campo de texto opcional de, como mucho, max caracteres.
    function textoOpc(k, max) { return nuevo().get(k, '') is string && nuevo().get(k, '').size() <= max; }
    // Reclamar una insignia automática: añade sólo «reclamada» a su mapa de insignias, con la fecha del servidor,
    // y la definición dice que es automática, que está activa y que el campo ya llega al umbral.
    function reclamaInsignia() {
      let id = nuevo().reclamada;
      let ant = viejo().get('insignias', {});
      let def = get(/databases/$(database)/documents/insignias/$(id)).data;
      return id is string && nuevo().insignias is map
        && nuevo().insignias.diff(ant).affectedKeys() == [id].toSet()
        && !(id in ant)
        && nuevo().insignias[id] == { 'f': request.time, 'n': 1 }
        && def.tipo == 'auto' && def.activa == true
        && viejo().get(def.campo, 0) >= def.umbral;
    }
    function bloqueada(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid))
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.get('bloqueado', false) == true;
    }

    match /usuarios/{uid} {
      allow read: if true;
      allow create: if esSuyo(uid)
        && nuevo().keys().hasOnly(['nombre', 'id', 'puntos', 'tests', 'ultimo', 'creado'])
        && nuevo().id is string && nuevo().nombre is string
        && request.auth.token.email == nuevo().id + '@usuarios.web-ing-inf.firebaseapp.com'
        && nuevo().nombre.size() == nuevo().id.size()
        && nuevo().puntos == 0 && nuevo().tests == 0
        && nuevo().ultimo == request.time && nuevo().creado == request.time;
      // El dueño, al terminar un test.
      allow update: if esSuyo(uid)
        && viejo().get('bloqueado', false) != true
        && nuevo().diff(viejo()).affectedKeys().hasOnly(['puntos', 'tests', 'ultimo', 'fli', 'fc', 'ip', 'gohp', semana()])
        && nuevo().ultimo == request.time
        && nuevo().tests == viejo().tests + 1
        && delta() >= 0 && delta() <= 2025
        && delta() <= 25 + (request.time - viejo().ultimo).seconds() * 4
        && unaAsignatura()
        && cambio(semana()) == delta();
      // El dueño: reclamar una insignia automática que ya se ha ganado.
      allow update: if esSuyo(uid)
        && viejo().get('bloqueado', false) != true
        && nuevo().diff(viejo()).affectedKeys().hasOnly(['insignias', 'reclamada'])
        && reclamaInsignia();
      // El dueño: elegir las insignias destacadas de su vitrina (sólo de las que tiene).
      allow update: if esSuyo(uid)
        && nuevo().diff(viejo()).affectedKeys().hasOnly(['vitrina'])
        && nuevo().vitrina is list && nuevo().vitrina.size() <= 6
        && viejo().get('insignias', {}).keys().hasAll(nuevo().vitrina);
      // Un administrador, desde el panel: corregir puntos (nunca negativos), bloquear o desbloquear y dar, quitar
      // o cambiar insignias (y quitarlas de la vitrina).
      allow update: if esAdmin()
        && nuevo().diff(viejo()).affectedKeys().hasOnly(['puntos', 'fli', 'fc', 'ip', 'gohp', 'bloqueado', semana(), 'insignias', 'vitrina'])
        && natural('puntos') && natural('fli') && natural('fc') && natural('ip') && natural('gohp') && natural(semana())
        && nuevo().get('bloqueado', false) is bool
        && nuevo().get('insignias', {}) is map
        && nuevo().get('vitrina', []) is list && nuevo().get('vitrina', []).size() <= 6;
      allow delete: if esSuyo(uid);
    }

    match /insignias/{id} {
      allow read: if true;
      allow create, update: if esAdmin()
        && id.matches('^[a-z][a-z0-9_]{1,39}$')
        && nuevo().keys().hasOnly(['nombre', 'desc', 'icono', 'forma', 'color', 'rareza', 'tipo', 'campo', 'umbral', 'orden', 'activa', 'actualizado', 'por'])
        && texto('nombre', 40) && nuevo().nombre.size() >= 2 && textoOpc('desc', 200) && texto('icono', 16)
        && nuevo().forma in ['escudo', 'hexagono', 'circulo', 'estrella', 'medalla', 'rombo']
        && nuevo().color in ['bronce', 'plata', 'oro', 'esmeralda', 'zafiro', 'rubi', 'amatista', 'noche', 'arcoiris']
        && nuevo().rareza in ['comun', 'rara', 'epica', 'legendaria']
        && nuevo().activa is bool && natural('orden')
        && (nuevo().tipo == 'manual'
            || (nuevo().tipo == 'auto' && nuevo().campo in ['puntos', 'tests', 'fli', 'fc', 'ip', 'gohp']
                && nuevo().umbral is int && nuevo().umbral >= 1))
        && nuevo().actualizado == request.time && texto('por', 40);
      allow delete: if esAdmin();
    }

    match /retos/{semana} {
      allow read: if true;
      allow create: if esAdmin()
        && semana.matches('^w[0-9]{1,6}$')
        && nuevo().keys().hasOnly(['ganadores', 'cerrado', 'por'])
        && texto('ganadores', 2000) && nuevo().cerrado == request.time && texto('por', 40);
      allow delete: if esAdmin();
    }

    match /progreso/{uid} {
      allow read, delete: if esSuyo(uid);
      allow create, update: if esSuyo(uid)
        && nuevo().keys().hasOnly(['t', 'json'])
        && nuevo().t is int && nuevo().json is string && nuevo().json.size() < 400000;
    }

    match /config/web {
      allow read: if true;
      allow create, update: if esAdmin()
        && nuevo().keys().hasOnly(['aviso', 'avisoTipo', 'avisoEnlace', 'avisoTextoEnlace', 'avisoHasta', 'avisoId',
                                   'examenes', 'actualizado', 'por'])
        && texto('aviso', 500) && nuevo().avisoTipo in ['info', 'importante']
        && texto('avisoEnlace', 300) && texto('avisoTextoEnlace', 60)
        && texto('avisoHasta', 10) && texto('avisoId', 40)
        && texto('examenes', 6000) && texto('por', 40)
        && nuevo().actualizado == request.time;
    }

    match /reportes/{id} {
      allow create: if request.auth != null
        && nuevo().keys().hasOnly(['uid', 'nombre', 'pagina', 'titulo', 'contexto', 'texto', 'estado', 'creado'])
        && nuevo().keys().hasAll(['uid', 'nombre', 'pagina', 'texto', 'estado', 'creado'])
        && nuevo().uid == request.auth.uid
        && texto('nombre', 20) && texto('pagina', 300)
        && textoOpc('titulo', 200) && textoOpc('contexto', 600)
        && texto('texto', 1500) && nuevo().texto.size() >= 5
        && nuevo().estado == 'abierto' && nuevo().creado == request.time
        && !bloqueada(request.auth.uid);
      allow read, delete: if esAdmin();
      allow update: if esAdmin()
        && nuevo().diff(viejo()).affectedKeys().hasOnly(['estado'])
        && nuevo().estado in ['abierto', 'resuelto'];
    }
  }
}
